# OrderBook Matcher 配置示例
# 复制此文件为 config.toml 并修改相应的值

[network]
# RPC WebSocket 端点
# 本地节点: ws://localhost:8545
# Alchemy Sepolia: wss://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
rpc_url = "wss://eth-sepolia.g.alchemy.com/v2/P2hms_foHU-rHhmt8hcpU"

# 链 ID
# 以太坊主网: 1
# Goerli: 5
# Sepolia: 11155111
# Hardhat/Anvil: 31337
chain_id = 11155111

[contracts]
# Sequencer 合约地址 (Sepolia - 带 matchAll 功能)
sequencer = "0xBAA2D96a3CE32EECdecCDF02136654cF01c06776"

# OrderBook 合约地址 (Sepolia - 带 matchAll 功能)
orderbook = "0x8e627Fc5D660D327C7e24465EB44430cf3e9Cf58"

# Account 合约地址 (Sepolia - 带 matchAll 功能)
account = "0x0fc28F3D6b8395a618C8fe8290cC5A680f0662dB"

# Trading Pair ID (WETH/USDC)
trading_pair = "0xe3fd74b5016b57bf4180a8d977a55d749f0f8f76be8d457de0768c85a6acc816"

[sync]
# 初始同步的起始区块
# 0 = 从最新区块开始
# 其他值 = 从指定区块开始同步
start_block = 0

# 是否同步历史区块数据
# true = 同步从 start_block 到当前的所有数据
# false = 只监听新事件
sync_historical = true

[matching]
# 每批最多处理的请求数（建议 50-200）
# 数值越大，单次交易 gas 越高，但处理效率越高
max_batch_size = 100

# 匹配间隔（毫秒）
# 数值越小，延迟越低，但可能增加无效查询
matching_interval_ms = 1000

[executor]
# ⚠️ 警告：不要将真实私钥提交到版本控制！
# 生产环境应使用环境变量或密钥管理系统

# 执行者私钥（用于发送交易）
# 示例：Hardhat Account #0
private_key = "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Gas 价格（gwei）
# 主网建议值：根据网络拥堵情况调整（通常 10-50）
# 测试网/本地：1
gas_price_gwei = 1

# Gas 限制
# 建议预留充足的 gas
gas_limit = 5000000

[mongodb]
# 启用 MongoDB 持久化存储
# 需要安装 MongoDB 或使用 Docker: docker-compose up -d mongodb
enabled = false
uri = "mongodb://localhost:27017"
database = "orderbook"

[api]
# 启用 HTTP API 服务器
# 依赖 MongoDB，提供 REST API 查询订单和交易数据
enabled = false
host = "127.0.0.1"
port = 8080
