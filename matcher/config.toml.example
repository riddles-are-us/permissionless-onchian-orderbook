# OrderBook Matcher 配置示例
# 复制此文件为 config.toml 并修改相应的值

[network]
# RPC WebSocket 端点
# 本地节点: ws://localhost:8545
# Alchemy Sepolia: wss://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
rpc_url = "wss://eth-sepolia.g.alchemy.com/v2/P2hms_foHU-rHhmt8hcpU"

# 链 ID
# 以太坊主网: 1
# Goerli: 5
# Sepolia: 11155111
# Hardhat/Anvil: 31337
chain_id = 11155111

[contracts]
# Sequencer 合约地址 (Sepolia - 最新部署，FIFO bugfix)
sequencer = "0xC46A3dCa464CA45c9Cc8814314ed2167C9e2c62e"

# OrderBook 合约地址 (Sepolia - 最新部署，FIFO bugfix)
orderbook = "0x61533685cE55F9667ff793409cab2da8De410422"

# Account 合约地址 (Sepolia - 最新部署，FIFO bugfix)
account = "0x28e020346e6E9EcF585341fd95C1C2a75744b172"

# Trading Pair ID (WETH/USDC)
trading_pair = "0xe3fd74b5016b57bf4180a8d977a55d749f0f8f76be8d457de0768c85a6acc816"

[sync]
# 初始同步的起始区块 (新部署的区块)
start_block = 9766246

# 是否同步历史区块数据
sync_historical = true

[matching]
# 每批最多处理的请求数
max_batch_size = 100

# 匹配间隔（毫秒）- Sepolia 区块时间约 12 秒
matching_interval_ms = 3000

[executor]
# 执行者私钥 (请替换为你自己的私钥)
private_key = "0xYOUR_PRIVATE_KEY_HERE"

# Gas 价格（gwei）- Sepolia 通常 1-5 gwei
gas_price_gwei = 2

# Gas 限制
gas_limit = 15000000

[mongodb]
# 启用 MongoDB 持久化
enabled = true
uri = "mongodb://localhost:27017"
database = "orderbook_0x61533685cE55F9667ff793409cab2da8De410422"

[api]
# 启用 HTTP API
enabled = true
host = "0.0.0.0"
port = 8080
