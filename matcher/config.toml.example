# OrderBook Matcher 配置示例
# 复制此文件为 config.toml 并修改相应的值

[network]
# RPC WebSocket 端点
# 本地节点: ws://localhost:8545
# Alchemy Sepolia: wss://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY
rpc_url = "wss://eth-sepolia.g.alchemy.com/v2/P2hms_foHU-rHhmt8hcpU"

# 链 ID
# 以太坊主网: 1
# Goerli: 5
# Sepolia: 11155111
# Hardhat/Anvil: 31337
chain_id = 11155111

[contracts]
# Sequencer 合约地址 (Sepolia - 带 matchAll 功能、新 OrderFilled 事件和 maker-taker 价格逻辑)
sequencer = "0xBF4AF7D81c5C68B606b7EF3E9746c92E30d37d73"

# OrderBook 合约地址 (Sepolia - 带 matchAll 功能、新 OrderFilled 事件和 maker-taker 价格逻辑)
orderbook = "0x66B541F03584636299C91eB54BB18994956417CC"

# Account 合约地址 (Sepolia - 带 matchAll 功能、新 OrderFilled 事件和 maker-taker 价格逻辑)
account = "0x6807633813d3Fe5f46Ec584C711Aa84984841807"

# Trading Pair ID (WETH/USDC)
trading_pair = "0xe3fd74b5016b57bf4180a8d977a55d749f0f8f76be8d457de0768c85a6acc816"

[sync]
# 初始同步的起始区块 (新部署的区块)
start_block = 9759321

# 是否同步历史区块数据
sync_historical = true

[matching]
# 每批最多处理的请求数
max_batch_size = 100

# 匹配间隔（毫秒）- Sepolia 区块时间约 12 秒
matching_interval_ms = 3000

[executor]
# 执行者私钥 (请替换为你自己的私钥)
private_key = "0xYOUR_PRIVATE_KEY_HERE"

# Gas 价格（gwei）- Sepolia 通常 1-5 gwei
gas_price_gwei = 2

# Gas 限制
gas_limit = 5000000

[mongodb]
# 启用 MongoDB 持久化
enabled = true
uri = "mongodb://localhost:27017"
database = "orderbook_0x66B541F03584636299C91eB54BB18994956417CC"

[api]
# 启用 HTTP API
enabled = true
host = "0.0.0.0"
port = 8080
